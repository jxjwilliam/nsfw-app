RH_API_KEY=your_32_char_runninghub_api_key

# Dev server port (npm run dev sources .env.local; default 4000)
PORT=4000

# ComfyUI workflow (optional — bypasses G-2 content safety when configured)
# 1) Import runninghub/workflows/sdxl-txt2img-api.json on https://www.runninghub.cn (see runninghub/workflows/README.md)
# 2) Copy the numeric ID from the workflow URL into RH_WORKFLOW_ID
RH_WORKFLOW_ID=

# Optional: override node IDs if your exported API JSON differs from the default workflow
# RH_WORKFLOW_PROMPT_NODE=6
# RH_WORKFLOW_NEGATIVE_NODE=7
# RH_WORKFLOW_SIZE_NODE=5
# RH_WORKFLOW_SAMPLER_NODE=3

# --- Local ComfyUI backend (optional; replaces RunningHub) -----------------
# Set BACKEND=local to plan/generate via the local ComfyUI at LOCAL_COMFY_URL.
# No cloud content review, no per-image cost. Leave unset for RunningHub.
# BACKEND=local
# LOCAL_COMFY_URL=http://localhost:8188
# Optional per-style checkpoint overrides (filename as shown in ComfyUI):
# LOCAL_CKPT_ANIME=ponyDiffusionV6XL_v6StartWithThisOne.safetensors
# LOCAL_CKPT_HENTAI=ponyDiffusionV6XL_v6StartWithThisOne.safetensors
# LOCAL_CKPT_HASSAKU=iniverseMixSFWNSFW_realXLV1.safetensors
# LOCAL_CKPT_REALISTIC=juggernautXL_ragnarokBy.safetensors

# --- NSFW workflow prompt generation (scripts/generate-nsfw-workflows.js) ---
# The generator randomly picks one of the configured LLMs per checkpoint to
# write explicit prompts. At least one key is required; add all three to rotate.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
#
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k3
#
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.7-max
